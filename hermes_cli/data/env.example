# Hermes secrets template (source examples, never a live configuration).
# Hermes copies this only when creating a missing .env, then encrypts the home.
# Use `hermes model`, `hermes setup`, and encrypted CLI writers for changes.
# Put models, URLs, terminal settings, and other behavior in config.yaml.
# Full reference: website/docs/reference/environment-variables.md

# Supported primary inference connections. ChatGPT and Grok subscriptions use
# `hermes model` sign-in; do not paste subscription tokens into this file.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LITELLM_API_KEY=
# GLM_API_KEY=
# XAI_API_KEY=
# AI_GATEWAY_API_KEY=
# Custom OpenAI/Anthropic endpoints use the key_env chosen in config.yaml.

# Optional search and image tools (configure their providers with Hermes).
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
# PARALLEL_API_KEY=
# FAL_KEY=

# Messaging. Enable only the platforms you use through `hermes gateway setup`.
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# API_SERVER_KEY=

# Other tool/plugin secrets are documented by their setup guides. Existing
# credentials for retired inference providers are preserved during updates.
# Never store a vault passphrase or a session-authority grant here.
